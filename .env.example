# ── Default image provider: gemini / openai / doubao ──
# Fill in only the provider you use; you can also switch per run with --provider.
IMAGE_PROVIDER=gemini

# ── Gemini (Nano Banana) ──
GEMINI_API_KEY=your_api_key_here
# Optional: third-party relay address; leave empty for Google's official endpoint
GEMINI_API_BASE_URL=
GEMINI_MODEL=gemini-3.1-flash-image-preview

# ── ChatGPT (OpenAI image models) ──
OPENAI_API_KEY=your_api_key_here
# Optional: third-party relay address; leave empty for OpenAI's official endpoint, e.g. https://api.example.com/v1
OPENAI_API_BASE_URL=
OPENAI_MODEL=gpt-image-2

# ── Doubao (Volcengine Ark Seedream) ──
# Create the key under "API Key Management" in the Ark console, and enable the model you use there first
DOUBAO_API_KEY=your_api_key_here
# Optional: leave empty to default to https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_BASE_URL=
# Use a model ID you have enabled in the console (see the console for newer versions such as Seedream 4.5 / 5.0)
DOUBAO_MODEL=doubao-seedream-4-0-250828

# Default folder for generated images (relative to the skill folder, or an absolute path)
LOGO_OUTPUT_DIR=output
