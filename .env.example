# ── 选择默认使用的图像模型：gemini / openai / doubao ──
# 只需要填你要用的那一家；出图时也可以用 --provider 临时切换。
IMAGE_PROVIDER=gemini

# ── Gemini（Nano Banana）──
GEMINI_API_KEY=your_api_key_here
# 可选：第三方中转地址，留空用 Google 官方
GEMINI_API_BASE_URL=
GEMINI_MODEL=gemini-3.1-flash-image-preview

# ── ChatGPT（OpenAI 图像模型）──
OPENAI_API_KEY=your_api_key_here
# 可选：第三方中转地址，留空用 OpenAI 官方，例如 https://api.example.com/v1
OPENAI_API_BASE_URL=
OPENAI_MODEL=gpt-image-2

# ── 豆包（火山方舟 Seedream）──
# key 在火山方舟控制台「API Key 管理」创建，并先在控制台开通所用模型
DOUBAO_API_KEY=your_api_key_here
# 可选：留空默认 https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_BASE_URL=
# 填控制台里已开通的模型 ID（Seedream 4.5 / 5.0 等更新版本在控制台查看）
DOUBAO_MODEL=doubao-seedream-4-0-250828

# 生成图片的默认保存目录（相对 skill 目录，或填绝对路径）
LOGO_OUTPUT_DIR=output
